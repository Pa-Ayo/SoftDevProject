# File:        .env.example
# Module:      Configuration
# Purpose:     Template for local settings. Copy it to .env (git-ignored) and fill in your own values.
# Responsible: Felix Joshua H. Abing
#
# Write values without quotes. On Render, set the same names as environment variables.

# --- Database: use ONE of these two ---
# Local development on the Firestore emulator (no account needed)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Production Firestore: path to the service-account JSON (keep it in the git-ignored secrets/ folder)
#FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json

# --- First administrator (only used while the admins collection is empty) ---
ADMIN_USERNAME=your-admin-username
ADMIN_EMAIL=your-admin-email@example.com
# 8 to 72 characters (this placeholder is too short on purpose)
ADMIN_PASSWORD=change

# --- Report photos: Cloudinary free plan (Dashboard > API Keys) ---
#CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# --- Password reset email: Brevo free plan (SMTP & API > SMTP) ---
#SPRING_MAIL_HOST=smtp-relay.brevo.com
#SPRING_MAIL_PORT=2525
#SPRING_MAIL_USERNAME=your-brevo-smtp-login
#SPRING_MAIL_PASSWORD=your-brevo-smtp-key
#MAIL_FROM=your-verified-sender@example.com
