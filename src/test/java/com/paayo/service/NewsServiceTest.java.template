package com.paayo.service;

import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.lenient;
import static org.mockito.Mockito.times;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

import com.paayo.model.NewsItem;
import com.paayo.newsbot.NewsScraper;
import com.paayo.newsbot.TextParaphraser;
import com.paayo.repository.NewsRepository;
import java.time.LocalDate;
import java.util.HashSet;
import java.util.List;
import java.util.Set;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.ArgumentCaptor;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

@ExtendWith(MockitoExtension.class)
class NewsServiceTest {
    private static final int MAX_SUMMARY = 300;

    @Mock
    private NewsRepository newsRepository;
    @Mock
    private NewsScraper scraper;

    private NewsService service;
    /** Pretends to be the database: remembers which sourceUrls were saved. */
    private final Set<String> savedUrls = new HashSet<>();

    @BeforeEach
    void setUp() {
        // The real paraphraser is used on purpose: TC-07 checks the summary length end to end.
        service = new NewsService(newsRepository, scraper, new TextParaphraser(MAX_SUMMARY));   // TODO: constructors
        lenient().when(newsRepository.existsBySourceUrl(anyString()))
                .thenAnswer(i -> savedUrls.contains(i.<String>getArgument(0)));
        lenient().when(newsRepository.save(any(NewsItem.class))).thenAnswer(i -> {
            NewsItem item = i.getArgument(0);
            savedUrls.add(item.getSourceUrl());
            return item;
        });
    }

    private NewsItem item(String url, String title) {
        NewsItem n = new NewsItem();
        n.setTitle(title);
        n.setSummary("The road will be closed for repairs. ".repeat(40));   // far longer than 300 chars
        n.setSourceName("Province of Cebu");
        n.setSourceUrl(url);
        n.setPublishedDate(LocalDate.of(2026, 11, 20));
        return n;
    }

    @Test
    @Tag("TC-07")
    @DisplayName("TC-07 fetchAndPublishNews saves >= 2 items, each summary <= 300 chars, with source link")
    void tc07_publishesAtLeastTwoShortSummaries() {
        when(scraper.scrape()).thenReturn(List.of(
                item("https://example.gov.ph/a", "Road rehabilitation"),
                item("https://example.gov.ph/b", "Drainage declogging")));

        int published = service.fetchAndPublishNews();

        assertThat(published).isGreaterThanOrEqualTo(2);
        ArgumentCaptor<NewsItem> saved = ArgumentCaptor.forClass(NewsItem.class);
        verify(newsRepository, times(2)).save(saved.capture());
        assertThat(saved.getAllValues()).allSatisfy(n -> {
            assertThat(n.getSummary().length()).isLessThanOrEqualTo(MAX_SUMMARY);
            assertThat(n.getSourceUrl()).startsWith("https://");
        });
    }

    @Test
    @Tag("TC-08")
    @DisplayName("TC-08 running again on the same sources creates 0 duplicates")
    void tc08_secondRunAddsNothing() {
        when(scraper.scrape()).thenReturn(List.of(
                item("https://example.gov.ph/a", "Road rehabilitation"),
                item("https://example.gov.ph/b", "Drainage declogging")));

        int first = service.fetchAndPublishNews();
        int second = service.fetchAndPublishNews();

        assertThat(first).isEqualTo(2);
        assertThat(second).isZero();
        verify(newsRepository, times(2)).save(any());   // still only the first run's 2 saves
    }

    @Test
    @Tag("TC-08")
    @DisplayName("TC-08 the same sourceUrl twice in one batch is saved once (NFR-11)")
    void tc08_duplicateInsideOneBatch() {
        when(scraper.scrape()).thenReturn(List.of(
                item("https://example.gov.ph/a", "Same story"),
                item("https://example.gov.ph/a", "Same story again")));

        assertThat(service.fetchAndPublishNews()).isEqualTo(1);
    }

    @Test
    @Tag("TC-10")
    @DisplayName("TC-10 a scraper that finds nothing (source down or layout changed) publishes 0 and does not crash")
    void tc10_nothingScrapedPublishesNothing() {
        when(scraper.scrape()).thenReturn(List.of());

        assertThat(service.fetchAndPublishNews()).isZero();
        verify(newsRepository, times(0)).save(any());
    }
}
