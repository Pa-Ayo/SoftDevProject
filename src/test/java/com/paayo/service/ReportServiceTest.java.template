package com.paayo.service;

import static org.assertj.core.api.Assertions.assertThat;
import static org.junit.jupiter.params.provider.Arguments.arguments;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.lenient;
import static org.mockito.Mockito.never;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.verifyNoInteractions;
import static org.mockito.Mockito.when;

import com.paayo.model.Category;
import com.paayo.model.Report;
import com.paayo.model.ReportStatus;
import com.paayo.repository.ReportRepository;
import java.util.function.Consumer;
import java.util.stream.Stream;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.Arguments;
import org.junit.jupiter.params.provider.EnumSource;
import org.junit.jupiter.params.provider.MethodSource;
import org.mockito.ArgumentCaptor;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.mock.web.MockMultipartFile;
import org.springframework.web.multipart.MultipartFile;

@ExtendWith(MockitoExtension.class)
class ReportServiceTest {
    @Mock
    private ReportRepository reportRepository;
    @Mock
    private ImageStorageService imageStorageService;

    private ReportService service;

    @BeforeEach
    void setUp() {
        service = new ReportService(reportRepository, imageStorageService);   // TODO: match the real constructor
        // The repository "saves" by returning what it was given.
        lenient().when(reportRepository.save(any(Report.class))).thenAnswer(i -> i.getArgument(0));
    }

    private Report validReport() {
        Report r = new Report();
        r.setTitle("Clogged storm drain");
        r.setCategory(Category.SANITATION);
        r.setLocation("A.S. Fortuna St., Banilad");
        r.setDescription("Debris blocks the main drain.");
        return r;
    }

    /** Submits and ignores a rejection, so a test can then check that nothing was written. */
    private void trySubmit(Report report, MultipartFile photo) {
        try {
            service.submitReport(report, photo);
        } catch (RuntimeException expectedRejection) {
            // TODO: if submitReport returns null/false instead of throwing, nothing to do here either
        }
    }

    // ---------------------------------------------------------------- TC-01
    @Test
    @Tag("TC-01")
    @DisplayName("TC-01 valid SANITATION report, no photo: saved with imageUrl=null, REPORTED, createdAt=updatedAt")
    void tc01_validReportWithoutPhotoIsSaved() {
        service.submitReport(validReport(), null);

        ArgumentCaptor<Report> saved = ArgumentCaptor.forClass(Report.class);
        verify(reportRepository).save(saved.capture());
        Report r = saved.getValue();
        assertThat(r.getTitle()).isEqualTo("Clogged storm drain");
        assertThat(r.getCategory()).isEqualTo(Category.SANITATION);
        assertThat(r.getImageUrl()).isNull();
        assertThat(r.getStatus()).isEqualTo(ReportStatus.REPORTED);
        assertThat(r.getCreatedAt()).isNotNull();
        assertThat(r.getUpdatedAt()).isEqualTo(r.getCreatedAt());
        verifyNoInteractions(imageStorageService);
    }

    // ---------------------------------------------------------------- TC-02
    static Stream<Arguments> missingFields() {
        return Stream.of(
                arguments("unselected category", (Consumer<Report>) r -> r.setCategory(null)),
                arguments("empty title", (Consumer<Report>) r -> r.setTitle("")),
                arguments("empty location", (Consumer<Report>) r -> r.setLocation("")),
                arguments("empty description", (Consumer<Report>) r -> r.setDescription("")));
    }

    @ParameterizedTest(name = "TC-02 blocked: {0}")
    @Tag("TC-02")
    @MethodSource("missingFields")
    void tc02_missingRequiredFieldIsBlocked(String label, Consumer<Report> breakIt) {
        Report r = validReport();
        breakIt.accept(r);

        assertThat(service.validateReport(r)).isFalse();
        trySubmit(r, null);
        verify(reportRepository, never()).save(any());
    }

    // ---------------------------------------------------------------- TC-03
    static Stream<Arguments> badValues() {
        return Stream.of(
                arguments("whitespace-only title", (Consumer<Report>) r -> r.setTitle("   ")),
                arguments("whitespace-only location", (Consumer<Report>) r -> r.setLocation(" \t ")),
                arguments("whitespace-only description", (Consumer<Report>) r -> r.setDescription("\n  ")),
                arguments("101-char title", (Consumer<Report>) r -> r.setTitle("t".repeat(101))),
                arguments("201-char location", (Consumer<Report>) r -> r.setLocation("l".repeat(201))),
                arguments("1001-char description", (Consumer<Report>) r -> r.setDescription("d".repeat(1001))));
    }

    @ParameterizedTest(name = "TC-03 rejected server-side: {0}")
    @Tag("TC-03")
    @MethodSource("badValues")
    void tc03_badValueIsRejected(String label, Consumer<Report> breakIt) {
        Report r = validReport();
        breakIt.accept(r);

        assertThat(service.validateReport(r)).isFalse();
        trySubmit(r, null);
        verify(reportRepository, never()).save(any());
    }

    @Test
    @Tag("TC-03")
    @DisplayName("TC-03 exactly 100/200/1000 characters is accepted")
    void tc03_limitsThemselvesAreAccepted() {
        Report r = validReport();
        r.setTitle("t".repeat(100));
        r.setLocation("l".repeat(200));
        r.setDescription("d".repeat(1000));

        assertThat(service.validateReport(r)).isTrue();
    }

    // ---------------------------------------------------------------- TC-05 (service part)
    @ParameterizedTest(name = "TC-05 admin moves report to {0}")
    @Tag("TC-05")
    @EnumSource(value = ReportStatus.class, names = {"IN_PROGRESS", "RESOLVED"})
    void tc05_statusChangeIsPassedToTheRepository(ReportStatus next) {
        service.updateReportStatus("report-1", next);

        verify(reportRepository).updateStatus("report-1", next);
    }

    // ---------------------------------------------------------------- TC-16 (a)(b)(c)
    @Test
    @Tag("TC-16")
    @DisplayName("TC-16(a) valid 1 MB JPEG: photo is stored and its URL is saved on the report")
    void tc16a_validPhotoIsStored() {
        MultipartFile photo = new MockMultipartFile("photoFile", "drain.jpg", "image/jpeg", new byte[1024 * 1024]);
        when(imageStorageService.storePhoto(photo)).thenReturn("https://res.cloudinary.com/demo/drain.jpg");

        service.submitReport(validReport(), photo);

        ArgumentCaptor<Report> saved = ArgumentCaptor.forClass(Report.class);
        verify(reportRepository).save(saved.capture());
        assertThat(saved.getValue().getImageUrl()).isEqualTo("https://res.cloudinary.com/demo/drain.jpg");
    }

    @Test
    @Tag("TC-16")
    @DisplayName("TC-16(b) no photo (also an empty file part from the browser): imageUrl stays null")
    void tc16b_noPhotoMeansPlaceholder() {
        MultipartFile emptyPart = new MockMultipartFile("photoFile", new byte[0]);

        service.submitReport(validReport(), emptyPart);

        ArgumentCaptor<Report> saved = ArgumentCaptor.forClass(Report.class);
        verify(reportRepository).save(saved.capture());
        assertThat(saved.getValue().getImageUrl()).isNull();
        verify(imageStorageService, never()).storePhoto(any());
    }

    @Test
    @Tag("TC-16")
    @DisplayName("TC-16(c) disallowed file: rejected, nothing saved or stored")
    void tc16c_badPhotoIsRejected() {
        MultipartFile exe = new MockMultipartFile("photoFile", "virus.exe", "application/octet-stream", new byte[10]);
        lenient().doThrow(new IllegalArgumentException("Photo must be JPEG, PNG or WebP up to 5 MB"))
                .when(imageStorageService).validatePhoto(exe);
        lenient().when(imageStorageService.storePhoto(exe)).thenThrow(new IllegalArgumentException("rejected"));

        trySubmit(validReport(), exe);

        verify(reportRepository, never()).save(any());
    }
}
